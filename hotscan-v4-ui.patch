+  var rare = state.collection.filter(function(car) { var r=(car.rarity||'').toLowerCase(); return r.includes('rare')||r.includes('error')||r.includes('vintage') }).length
+  var newest = state.collection[0] ? (state.collection[0].name || '') : ''
+
+  var txt = [
+    '🚗 My HotScan India Collection',
