+// ── Scan Streak ─────────────────────────────────────────────────────────────
+export function updateStreak() {
+  var today = new Date().toDateString()
+  var yesterday = new Date(Date.now() - 86400000).toDateString()
+  var streak = JSON.parse(localStorage.getItem('hs_streak') || '{"count":0,"last":""}')
+
+  // If scanned today already, streak is current — just display
+  if (streak.last === today) {
+    // Already counted
+  } else if (streak.last === yesterday) {
+    // Extend streak only when a scan fires — called from incScans()
+    streak = { count: streak.count + 1, last: today }
+    localStorage.setItem('hs_streak', JSON.stringify(streak))
+  } else if (streak.last !== today) {
+    // Streak broken — reset
+    streak = { count: 1, last: today }
+    localStorage.setItem('hs_streak', JSON.stringify(streak))
+  }
+
+  var el = document.getElementById('hdr-streak')
+  if (el && streak.count >= 2) {
+    el.textContent = '🔥 ' + streak.count + ' day streak'
+    el.style.display = 'inline-flex'
+  } else if (el) {
+    el.style.display = 'none'
+  }
+  return streak.count
+}
