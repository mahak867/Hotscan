+    th  > 0 ? '🔥 ' + th  + ' Treasure Hunt' + (th > 1 ? 's' : '') : '',
+    rare > 0 ? '💎 ' + rare + ' Rare/Vintage' : '',
+    newest ? '🆕 Latest: ' + newest : '',
+    '',
+    '📷 Track yours free at hotscan.in'
+  ].filter(Boolean).join('
+')
+
+  if (navigator.share) {
+    navigator.share({ title: 'My HotScan Collection', text: txt }).catch(function(){})
+  } else if (navigator.clipboard) {
+    navigator.clipboard.writeText(txt).then(function() { showToast('Collection stats copied! Paste to WhatsApp or Instagram.', 'success') })
+  } else {
+    showToast('Copy this:\n' + txt, 'success')
+  }
+}
