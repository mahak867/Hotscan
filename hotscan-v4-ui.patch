+// HotScan India — Daily Reminder Push
+// Vercel Cron: runs at 12:30 UTC (6:00 PM IST) every day
+// Sends a gentle deal-alert reminder to users who haven't scanned today
+export const config = { runtime: 'edge' }
+
+const SUPA_URL = process.env.VITE_SUPA_URL
+const SUPA_SERVICE_KEY = process.env.SUPABASE_SERVICE_KEY
+const PUSH_SEND_URL = process.env.VERCEL_URL
+  ? 'https://' + process.env.VERCEL_URL + '/api/push-send'
+  : 'https://www.hotscan.in/api/push-send'
+
+export default async function handler(req) {
+  // Only Vercel cron can call this (verified via header)
+  if (req.headers.get('authorization') !== 'Bearer ' + SUPA_SERVICE_KEY) {
+    return new Response('Unauthorized', { status: 401 })
+  }
+
+  // Get all push subscribers
+  const res = await fetch(`${SUPA_URL}/rest/v1/push_subscriptions?select=user_id`, {
+    headers: { apikey: SUPA_SERVICE_KEY, Authorization: `Bearer ${SUPA_SERVICE_KEY}` }
+  })
+  const users = await res.json()
+  if (!users || !users.length) return new Response('No subscribers', { status: 200 })
+
+  const messages = [
+    { title: '🔍 Any new Hot Wheels today?', body: 'Scan it and check the India collector price instantly.' },
+    { title: '🔥 Deal waiting?', body: 'Check your alerts — OLX prices shift daily.' },
+    { title: '🚗 Your collection misses you', body: 'Got a new car? Add it to HotScan and track its value.' },
+    { title: '⭐ Super Treasure Hunt alert', body: 'STH season is on. Scan before you buy to avoid fakes.' },
+  ]
+  const msg = messages[new Date().getDay() % messages.length]
+
+  // Fire push to all subscribers (non-blocking)
+  const results = await Promise.allSettled(users.map(function(u) {
+    return fetch(PUSH_SEND_URL, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: 'Bearer ' + SUPA_SERVICE_KEY,
+      },
+      body: JSON.stringify({ user_id: u.user_id, title: msg.title, message: msg.body, url: '/' })
+    })
+  }))
+
+  var sent = results.filter(function(r) { return r.status === 'fulfilled' }).length
+  return new Response(JSON.stringify({ sent, total: users.length }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  })
+}
