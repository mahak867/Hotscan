+++ b/src/groq.js
@@ -54,15 +54,23 @@ async function callVision(model, imageData, systemPrompt, userPrompt) {
 }
 
 export async function groqVision(imageData, systemPrompt, userPrompt) {
-  try {
-    return await callVision(VISION_MODEL, imageData, systemPrompt, userPrompt)
-  } catch(e) {
-    if (e.modelError) {
-      if (typeof captureException === 'function') captureException(new Error('Vision model fallback: ' + VISION_MODEL + ' → ' + VISION_FALLBACK))
-      return await callVision(VISION_FALLBACK, imageData, systemPrompt, userPrompt)
+  // Wrap primary + fallback in a 30s hard timeout
+  var timeoutP = new Promise(function(_, rej) {
+    setTimeout(function() { rej(new Error('AI vision timed out — try again or use a clearer photo')) }, 30000)
+  })
+  async function attempt() {
+    try {
+      return await callVision(VISION_MODEL, imageData, systemPrompt, userPrompt)
+    } catch(e) {
+      // Fallback on model errors (deprecated, overloaded) but not on user errors (bad image)
+      if (e.modelError) {
+        if (typeof captureException === 'function') captureException(new Error('Vision fallback: ' + VISION_MODEL + ' → ' + VISION_FALLBACK))
+        return await callVision(VISION_FALLBACK, imageData, systemPrompt, userPrompt)
+      }
+      throw e
     }
-    throw e
   }
+  return Promise.race([attempt(), timeoutP])
 }
 
