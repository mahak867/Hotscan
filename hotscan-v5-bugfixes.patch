     s.bonus = (s.bonus || 0) + 10
diff --git a/supabase_migration.sql b/supabase_migration.sql
index 805effa..fc5f8da 100644
--- a/supabase_migration.sql
+++ b/supabase_migration.sql
@@ -304,3 +304,14 @@ create policy "push_sub_insert_own" on push_subscriptions
 create policy "push_sub_delete_own" on push_subscriptions
   for delete using (auth.uid() = user_id);
 -- Service role (used by push-subscribe API) bypasses RLS — no extra policy needed
+
+
+-- Referral claims table — prevents localStorage bypass of referral bonus
+create table if not exists referral_claims (
+  user_id    uuid primary key references auth.users(id) on delete cascade,
+  ref_code   text not null,
+  claimed_at timestamptz default now()
+);
+alter table referral_claims enable row level security;
+create policy "ref_claims_own" on referral_claims
+  for all using (auth.uid() = user_id);
