{
  "manifest_version": 3,
  "name": "HotScan India",
  "short_name": "HotScan",
  "version": "1.0.1",
  "description": "India's #1 Hot Wheels scanner. Identify any car by name or barcode, get Indian market prices and investment ratings instantly.",
  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "HotScan India — Hot Wheels Scanner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*"
  ]
}
