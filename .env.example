# HotScan India — Environment Variables
#
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The Vite dev server reads variables prefixed with VITE_ and injects
# them at build time via import.meta.env.*
# Variables without the VITE_ prefix are only available server-side
# (Vercel Edge Functions in the /api directory).
#
# ── Vercel Edge Function (api/groq.js) ───────────────────────────────────────
# At least one Groq API key is required for the AI features to work.
# Get free keys at https://console.groq.com (takes ~2 minutes each).
# Up to 5 keys are supported — they rotate round-robin to spread quota.
GROQ_API_KEY_1=gsk_your_key_here
# GROQ_API_KEY_2=gsk_optional_second_key
# GROQ_API_KEY_3=gsk_optional_third_key
# GROQ_API_KEY_4=gsk_optional_fourth_key
# GROQ_API_KEY_5=gsk_optional_fifth_key

# ── Supabase (client-side, safe to expose) ───────────────────────────────────
# The anon/public key is intentionally designed to be shipped to browsers.
# Access is controlled by Row-Level Security (RLS) policies in Supabase.
# See: https://supabase.com/docs/guides/api/api-keys
VITE_SUPA_URL=https://your-project-ref.supabase.co
VITE_SUPA_KEY=your_supabase_anon_key

# ── Razorpay (client-side publishable key) ───────────────────────────────────
# The publishable key is safe to expose in the browser (similar to
# Stripe's publishable key). Only the secret key must be kept private.
# See: https://razorpay.com/docs/payments/payment-gateway/web-integration/standard/
VITE_RZP_KEY=rzp_test_your_key_here
