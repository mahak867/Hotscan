# HotScan India — Environment Variables
# Copy this file to .env.local for local dev, set these in Vercel dashboard for production.
# NEVER commit .env.local to git.

# Supabase (get from Supabase dashboard → Project Settings → API)
# The anon key is safe to be public — RLS policies enforce all access control.
VITE_SUPA_URL=https://your-project.supabase.co
VITE_SUPA_KEY=your-supabase-anon-key

# Razorpay (get from Razorpay dashboard → Settings → API Keys)
# Use rzp_test_... for dev, rzp_live_... for production (NEVER commit live key)
VITE_RZP_KEY=rzp_test_your_key_here

# Gemini — PRIMARY vision provider (get a free key at aistudio.google.com/apikey).
# Groq's free tier is 8,000 tokens/minute shared across every user of the app,
# which is roughly four scans a minute in total; Gemini's free tier is far
# larger. Check your exact limits in AI Studio — they are model- and
# account-specific. Without this key the proxy simply uses Groq as before.
GEMINI_API_KEY=your_gemini_key
# Optional: pin the model. Google deprecates model IDs on a schedule
# (gemini-2.5-flash retires 2026-10-16), and a dead ID breaks scanning silently.
GEMINI_MODEL=gemini-2.5-flash
# Optional: set to 0 to put Groq back in front without deploying code.
GEMINI_PRIMARY=1

# Groq AI keys — now the FALLBACK, used when Gemini is out of quota or erroring.
# Kept because Groq is materially faster and two independent free tiers means
# one provider's outage is not an outage of the product.
# Up to 5 for round-robin rotation (free keys at console.groq.com)
GROQ_API_KEY_1=gsk_your_first_key
GROQ_API_KEY_2=gsk_your_second_key

# Razorpay webhook secret (set this in Razorpay dashboard when creating the webhook)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Supabase service role key — ONLY used in Edge Functions, never in frontend
# Get from Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Developer email — grants dev privileges in the app (your own email)
VITE_DEV_EMAIL=your@email.com
